#
# Book Lending Manager - Apache Rewrite Rules
#
# This file routes all requests to index.php (Front Controller pattern)
# Place this file in your public_html/ directory
#

# Enable rewrite engine
RewriteEngine On

# Set base directory (adjust if installed in subdirectory)
# RewriteBase /

# Don't rewrite files or directories that exist
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all other requests to index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Disable directory browsing
Options -Indexes

# PHP settings (uncomment if needed and allowed)
# php_value upload_max_filesize 10M
# php_value post_max_size 10M
# php_value memory_limit 128M
