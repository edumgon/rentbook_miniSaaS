#
# Environment Configuration
# 
# INSTRUÇÕES PARA CPANEL:
# 1. Copie este arquivo para .env (sem o .example)
# 2. Preencha com suas credenciais reais
# 3. NÃO commite o arquivo .env no Git!
#

# ==========================================
# CONFIGURAÇÃO DO BANCO DE DADOS (cPanel)
# ==========================================
# Crie o banco no cPanel > MySQL Databases
# Crie um usuário e adicione ao banco
DB_HOST=localhost
DB_NAME=seu_banco_de_dados
DB_USER=seu_usuario_mysql
DB_PASS=sua_senha_mysql

# ==========================================
# CONFIGURAÇÃO GOOGLE OAUTH
# ==========================================
# 1. Acesse: https://console.cloud.google.com/apis/credentials
# 2. Crie um projeto
# 3. Habilite "Google+ API" (ou People API)
# 4. Crie credenciais OAuth 2.0 tipo "Web application"
# 5. Adicione o redirect URI: https://seudominio.com/auth/callback
# 6. Copie Client ID e Client Secret para cá

GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REDIRECT_URI=https://seudominio.com/auth/callback

# ==========================================
# CONFIGURAÇÃO GOOGLE BOOKS API
# ==========================================
# 1. Acesse: https://console.cloud.google.com/apis/credentials
# 2. Use o mesmo projeto do OAuth
# 3. Habilite "Books API"
# 4. Crie credenciais tipo "API Key"
# 5. (Opcional) Configure restrições para a API Key:
#    - Application restrictions: HTTP referrers (seudominio.com)
#    - API restrictions: Books API apenas
# 6. Copie a API Key para cá
# NOTA: Se deixar em branco, o sistema usará apenas Open Library

GOOGLE_BOOKS_API_KEY=

# ==========================================
# CONFIGURAÇÃO DO SISTEMA
# ==========================================
APP_ENV=production
APP_DEBUG=false
